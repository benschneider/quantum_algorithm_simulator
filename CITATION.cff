title: "Quantum Algorithm Simulator (quantsim)"
version: "0.4.3"
doi: "10.5281/zenodo.24518850"
authors:
  - family-names: Schneider
    given-names: Ben Helmut
    orcid: "https://orcid.org/0000-0001-9043-2170"
